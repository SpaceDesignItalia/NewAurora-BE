generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  user_id         BigInt           @id @default(autoincrement())
  name            String
  surname         String
  email           String           @unique
  password        String
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt
  projects        Project[]
  project_members Project_Member[]
  tasks           Task[]
  sprints         Sprint[]
  password_resets PasswordReset[]
}

model PasswordReset {
  password_reset_id BigInt   @id @default(autoincrement())
  email             String
  otp               String
  expires_at        DateTime
  is_used           Boolean  @default(false)
  created_at        DateTime @default(now())
  user_id           BigInt?
  user              User?    @relation(fields: [user_id], references: [user_id])
}

model Project_Status {
  project_status_id BigInt    @id @default(autoincrement())
  name              String
  color             String?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  projects          Project[]
}

model Project {
  project_id        BigInt           @id @default(autoincrement())
  unique_id         String           @unique @default(uuid())
  name              String
  description       String?
  start_date        DateTime?
  end_date          DateTime?
  project_status_id BigInt
  created_by_id     BigInt
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt
  created_by        User             @relation(fields: [created_by_id], references: [user_id])
  project_status    Project_Status   @relation(fields: [project_status_id], references: [project_status_id])
  project_members   Project_Member[]
  task_statuses     Task_Status[]
  sprints           Sprint[]
  tasks             Task[]
}

model Project_Member {
  project_member_id BigInt   @id @default(autoincrement())
  project_id        BigInt
  user_id           BigInt
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  project           Project  @relation(fields: [project_id], references: [project_id])
  user              User     @relation(fields: [user_id], references: [user_id])
}

model Task_Status {
  task_status_id BigInt    @id @default(autoincrement())
  name           String 
  color          String? @default("#000000")
  project_id     BigInt
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  tasks          Task[]
  project        Project   @relation(fields: [project_id], references: [project_id])
}

model Task_Priority {
  task_priority_id BigInt    @id @default(autoincrement())
  name             String
  color            String? @default("#000000")
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  tasks            Task[]
}

model Sprint {
  sprint_id    BigInt    @id @default(autoincrement())
  name         String
  description  String?
  start_date   DateTime
  end_date     DateTime
  is_active    Boolean   @default(false)
  is_completed Boolean   @default(false)
  project_id    BigInt
  created_by_id BigInt
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  project       Project   @relation(fields: [project_id], references: [project_id])
  created_by    User      @relation(fields: [created_by_id], references: [user_id])
  tasks         Task[]
  completed_at  DateTime?
}

model Task {
  task_id           BigInt        @id @default(autoincrement())
  title             String
  description       String
  task_status_id    BigInt
  task_priority_id  BigInt
  story_points      Int?
  sprint_id         BigInt?
  project_id        BigInt
  created_by_id     BigInt
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt
  task_status       Task_Status   @relation(fields: [task_status_id], references: [task_status_id])
  task_priority     Task_Priority @relation(fields: [task_priority_id], references: [task_priority_id])
  sprint            Sprint?       @relation(fields: [sprint_id], references: [sprint_id])
  project           Project       @relation(fields: [project_id], references: [project_id])
  created_by        User          @relation(fields: [created_by_id], references: [user_id])
}


model Feature_Flag {
  feature_flag_id BigInt    @id @default(autoincrement())
  name            String
  key             String
  description     String?
  default_value   Boolean
  targets         Target[]
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
}

model Target {
  target_id BigInt    @id @default(autoincrement())
  name      String
  type      String
  operator  String
  value     String
  feature_flag_id BigInt
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  feature_flag Feature_Flag @relation(fields: [feature_flag_id], references: [feature_flag_id])
}
